{
  "name": "@dj-meyers/galewings",
  "version": "0.0.1",
  "description": "Shared schemas and types for the Galewings API (zod schemas, derived domain types, and tRPC AppRouter type).",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DJ-Meyers/galewings-api.git",
    "directory": "packages/shared-types"
  },
  "dependencies": {
    "@pkmn/data": "^0.10.9",
    "@pkmn/dex": "^0.10.9",
    "@pkmn/mods": "^0.10.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@galewings/server": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
